        ],
        "pointer": "/conversations/557/dialogueEntries/27/fields/6/value",
        "source": "The elder mice's chants become louder! Pink flames and streaks explode out from the campfire! As this happens, the group of mice pair off and begin kissing.",
        "sourceSha256": "22253d2de8beb932469f7b39472c4b639300d11b3927f85295384834c039cf1d",
        "target": "Песнопения старейшин становятся громче! Из костра вырываются розовые языки пламени и огненные полосы! В этот миг мыши разбиваются на пары и начинают целоваться.",
        "targetSha256": "be0213c32cb8d10482ab82eea8be94513c77ce3a36194f51f9ea4d0c1276689a",
        "status": "edited-provisional",
