        ],
        "pointer": "/conversations/557/dialogueEntries/23/fields/6/value",
        "source": "Small paws move methodically over Rascal's body, tracing bold strokes and intricate swirls. The mice work in perfect harmony.",
        "sourceSha256": "d08635bd5d7da4f3243c0be60dd3cb0c88023d175ab3cb0523a6df338aca80c5",
        "target": "Маленькие лапки размеренно скользят по телу Плута, выводя смелые штрихи и замысловатые завитки. Мыши работают в полном согласии.",
        "targetSha256": "2fe739ace5dea80b6b07ed94b5f9dd999d1d79d673b7243f2bdd4d8b43f3eb10",
        "status": "edited-provisional",
