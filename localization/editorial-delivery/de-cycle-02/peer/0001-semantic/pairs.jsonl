{"id":"ds:947:139:Dialogue Text","source":"Just the casual romp?","target":"Nur ab und zu ein lockeres Schäferstündchen?","sourceSha256":"9a7dcd287dc2913ca55998d1f51c635d9b55c1bceea5dc152865a01d94a812f5","targetSha256":"bb58b70f052ca3e1a887c506741adebe1c2f1d4a115f7cc2d3125bf6a4f6bed7","conversationId":947,"conversation":"gossip/donkey/seeingAnyone","actor":"1","conversant":"15","title":"","sequence":"","conditions":"","script":"","links":[{"originConversationID":947,"originDialogueID":139,"destinationConversationID":947,"destinationDialogueID":140,"isConnector":0,"priority":2}],"isGroup":0,"unchangedReason":null,"unchangedCategory":null}
{"id":"ds:947:141:Dialogue Text","source":"[pic=5]I have been… seeing someone more often than others though…","target":"[pic=5]Allerdings gibt es … jemanden, den ich öfter treffe als andere …","sourceSha256":"5d0067dc4db6806ee02c0be859b5eac32d933dd7bf513b009d1f0079ea8348b6","targetSha256":"8dfa8d6ab7c51e70208efc497901cc86598619c48926dba55242de3bf711ba01","conversationId":947,"conversation":"gossip/donkey/seeingAnyone","actor":"15","conversant":"1","title":"","sequence":"","conditions":"","script":"","links":[{"originConversationID":947,"originDialogueID":141,"destinationConversationID":947,"destinationDialogueID":142,"isConnector":0,"priority":2}],"isGroup":0,"unchangedReason":null,"unchangedCategory":null}
