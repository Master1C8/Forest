{"family": "dialogue", "id": "ds:139:180:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/64/dialogueEntries/52/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/64/dialogueEntries/52/fields/6/value"}], "source": "[pic=8]And nothing rhymes with Plume!", "context": {"actorId": "2", "conditions": "", "conversantId": "1", "conversation": "dates/scarlettPenny/dialogue", "conversationId": 139, "entryId": 180, "field": "Dialogue Text", "next": [[139, 182]], "script": ""}, "sourceSha256": "174453b3212de63d4df07486ef073fe9e0a46da5a6a943f71ff4d890912daffa", "preserveExactly": false, "sourceOrdinal": 1341, "target": "[pic=8]A s Plume se nic nerýmuje!", "targetSha256": "a759b7970cdb2b422544da81c17e84436cdd77b3fdfb2d2d377efcc857c7baf3"}
{"family": "dialogue", "id": "ds:139:182:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/64/dialogueEntries/54/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/64/dialogueEntries/54/fields/6/value"}], "source": "[pic=11]Penny Plume’s Ride and Spoon? Penny Plume’s Ride and Poon?", "context": {"actorId": "8", "conditions": "", "conversantId": "1", "conversation": "dates/scarlettPenny/dialogue", "conversationId": 139, "entryId": 182, "field": "Dialogue Text", "next": [[139, 183]], "script": ""}, "sourceSha256": "9c54c389208b0cd7625424099e702838f4b9338320fd927d4ed7709fc55d8ae2", "preserveExactly": false, "sourceOrdinal": 1343, "target": "[pic=11]Penny Plume: Ride and Spoon – letem s přitulením? Penny Plume: Ride and Poon – letem za pičkou?", "targetSha256": "d5afb9610c06d867161ee77961f044bfcafce4fd6d0fa73946468c9d4c335ae9"}
{"family": "dialogue", "id": "ds:1443:446:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/494/dialogueEntries/22/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/494/dialogueEntries/22/fields/6/value"}], "source": "Haha, then I can be there to fluff you up!", "context": {"actorId": "1", "conditions": "", "conversantId": "15", "conversation": "act3/maverickSideHustleQuest/04_returnToOliver", "conversationId": 1443, "entryId": 446, "field": "Dialogue Text", "next": [[1443, 447]], "script": ""}, "sourceSha256": "8fbb9b962566d65325cb0cecb47da21fc8d45a8488edbc872bb20deea74a25a9", "preserveExactly": false, "sourceOrdinal": 1473, "target": "Haha, tak tam můžu být já a pomoct ti ho postavit!", "targetSha256": "75327636fb84b7f48d843c99be895901c11cb8dc63594c05eff62c09010a3769"}
{"family": "dialogue", "id": "ds:145:266:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/13/dialogueEntries/74/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/13/dialogueEntries/74/fields/6/value"}], "source": "I think I’ve been here before…", "context": {"actorId": "7", "conditions": "", "conversantId": "1", "conversation": "act1/newGame", "conversationId": 145, "entryId": 266, "field": "Dialogue Text", "next": [[145, 267]], "script": ""}, "sourceSha256": "91132e6e33383cf5925a9afeff43ff8de0d45c9410182d1b875e2abb79dda705", "preserveExactly": false, "sourceOrdinal": 1674, "target": "Myslím, že tu nejsem poprvé…", "targetSha256": "7d283f4972f475c7e409e114ed9efbf044e23971d051fa813ef9d0259b5d717c"}
{"family": "dialogue", "id": "ds:145:267:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/13/dialogueEntries/75/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/13/dialogueEntries/75/fields/6/value"}], "source": "Or…have I?", "context": {"actorId": "7", "conditions": "", "conversantId": "1", "conversation": "act1/newGame", "conversationId": 145, "entryId": 267, "field": "Dialogue Text", "next": [[145, 261]], "script": ""}, "sourceSha256": "28ba32278442b159de126d91a8814919a984ce885b15b1b7a451555be3bb9110", "preserveExactly": false, "sourceOrdinal": 1675, "target": "Nebo… jsem?", "targetSha256": "83460b20cf40b5dbe5cf1271b3435a09ae59e5cb9472e1848d94263458c0f94a"}
{"family": "dialogue", "id": "ds:150:137:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/151/dialogueEntries/6/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/151/dialogueEntries/6/fields/6/value"}], "source": "[pic=1]Scarlett has had a ton of fun pegging me in the past, and she’s been known to surprise me with some male partners from time to time!", "context": {"actorId": "16", "conditions": "", "conversantId": "1", "conversation": "gossip/bunnyPeter/orientation", "conversationId": 150, "entryId": 137, "field": "Dialogue Text", "next": [[150, 138]], "script": ""}, "sourceSha256": "b9e08d8ebc5492f918b1c9b46e62db20da95b6d2eadbf9f07719ffcb84788f13", "preserveExactly": false, "sourceOrdinal": 1735, "target": "[pic=1]Scarlett si v minulosti užila spoustu zábavy, když mě šukala se strap-onem, a čas od času mě překvapí i nějakejma mužskejma partnerama!", "targetSha256": "a8bdebda2fcf1cb32fb697d6e743abb5c3e30a820490a8b8526d0498089c8019"}
{"family": "dialogue", "id": "ds:153:18:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/103/dialogueEntries/2/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/103/dialogueEntries/2/fields/6/value"}], "source": "What a peculiar glyph!", "context": {"actorId": "7", "conditions": "", "conversantId": "1", "conversation": "examinables/lake/ruins_center_glyph", "conversationId": 153, "entryId": 18, "field": "Dialogue Text", "next": [[153, 19]], "script": ""}, "sourceSha256": "fab72b8d67e7403116cd1143e770e6b1e41cb9cbb2b8cae3c33a3945d01b8ca2", "preserveExactly": false, "sourceOrdinal": 1762, "target": "To je ale zvláštní glyf!", "targetSha256": "4a2ee93f499ea8edeaeb8f79a053335dc442369929aa63d110389b557c49d1a0"}
{"family": "dialogue", "id": "ds:154:18:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/104/dialogueEntries/2/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/104/dialogueEntries/2/fields/6/value"}], "source": "A monument of some sort, covered by mysterious inscriptions and strange glyphs.", "context": {"actorId": "7", "conditions": "", "conversantId": "1", "conversation": "examinables/lake/ruins_monument_glyphs", "conversationId": 154, "entryId": 18, "field": "Dialogue Text", "next": [[154, 19]], "script": ""}, "sourceSha256": "fd77b0a9f4b92d7d90b422833e24cd332fa060225e6f7909bdbd464607814e32", "preserveExactly": false, "sourceOrdinal": 1764, "target": "Jakýsi památník pokrytý tajemnými nápisy a podivnými glyfy.", "targetSha256": "6ed9fa48615917c90b84276a3369b04e89bc5f3610fed600a8deda0b1424b49f"}
{"family": "dialogue", "id": "ds:202:148:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/168/dialogueEntries/3/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/168/dialogueEntries/3/fields/6/value"}], "source": "[pic=5]You may have spotted a few runes/glyphs here ‘n there yes?", "context": {"actorId": "9", "conditions": "", "conversantId": "1", "conversation": "gossip/gator/history", "conversationId": 202, "entryId": 148, "field": "Dialogue Text", "next": [[202, 149]], "script": ""}, "sourceSha256": "e8ad90fcf4e198f173ca91f898aa3f9016053a8f62b874622404372de3363993", "preserveExactly": false, "sourceOrdinal": 2184, "target": "[pic=5]Možná sis tu a tam všiml nějakých run či glyfů, že?", "targetSha256": "23167e2264fb1cfcd788c56bb476a125f4ce5795cd0fe6745fe3454bc0af4add"}
{"family": "dialogue", "id": "ds:204:168:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/167/dialogueEntries/2/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/167/dialogueEntries/2/fields/6/value"}], "source": "Glyphs?", "context": {"actorId": "1", "conditions": "", "conversantId": "9", "conversation": "gossip/gator/glyphs", "conversationId": 204, "entryId": 168, "field": "Dialogue Text", "next": [[204, 169]], "script": ""}, "sourceSha256": "1e0db41d492c9bfac73300712f0fdd9f0ab19ef1c4edad0331b31bedaefa7c77", "preserveExactly": false, "sourceOrdinal": 2204, "target": "Glyfy?", "targetSha256": "b08dcef89ea9667d69b0ca89764893e19fa01b7134f47cab241879ed1e4e77f6"}
{"family": "dialogue", "id": "ds:204:169:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/167/dialogueEntries/3/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/167/dialogueEntries/3/fields/6/value"}], "source": "[pic=2]No doubt you’ve seen a few reoccurring glyphs around.", "context": {"actorId": "9", "conditions": "", "conversantId": "1", "conversation": "gossip/gator/glyphs", "conversationId": 204, "entryId": 169, "field": "Dialogue Text", "next": [[204, 170]], "script": ""}, "sourceSha256": "9b1cd5e8a3e2b4b4bda98210dd972398c61c6b7ca542269c1023eaa56a3e49d9", "preserveExactly": false, "sourceOrdinal": 2205, "target": "[pic=2]Nepochybně sis v okolí všiml několika opakujících se glyfů.", "targetSha256": "301bda8a0799ee9f4cb7c26cc5cc73da677625b9bb271fc0537a1b3442f82357"}
{"family": "dialogue", "id": "ds:294:171:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/170/dialogueEntries/15/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/170/dialogueEntries/15/fields/6/value"}], "source": "[pic=7]Like half of the glyphs are about how they switch sides, fill her holes, bathe her in their… *ahem* well, you know…", "context": {"actorId": "9", "conditions": "", "conversantId": "1", "conversation": "gossip/gator/lanoraPart2", "conversationId": 294, "entryId": 171, "field": "Dialogue Text", "next": [[294, 172]], "script": ""}, "sourceSha256": "1a69092c516f8251783f2f32317f520bd4bc3fcaa26456774dc2520bbf43ff9b", "preserveExactly": false, "sourceOrdinal": 3531, "target": "[pic=7]Snad polovina glyfů pojednává o tom, jak si vyměňují strany, plní její otvory a koupou ji ve své… *ehm* však víš…", "targetSha256": "9bbde93e4a54902ee1cfe41e91f1127666d507fd6e3dc255fe191a80704ba710"}
{"family": "dialogue", "id": "ds:312:18:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/310/dialogueEntries/2/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/310/dialogueEntries/2/fields/6/value"}], "source": "There's a bunch of glyphs carved here... No idea what it says.", "context": {"actorId": "7", "conditions": "", "conversantId": "1", "conversation": "examinables/glyphstones", "conversationId": 312, "entryId": 18, "field": "Dialogue Text", "next": [], "script": ""}, "sourceSha256": "38f22c9e77489f30200568ab52b9e3f80ba0c13a95f9a776d0588b07c612f17c", "preserveExactly": false, "sourceOrdinal": 4241, "target": "Je tu vyryta spousta glyfů... Nemám ponětí, co se tam píše.", "targetSha256": "466a89ffb38998554c709316f3ba60f7a91ad22fed302130a786511ef370e5b5"}
{"family": "dialogue", "id": "ds:343:7:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/341/dialogueEntries/6/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/341/dialogueEntries/6/fields/6/value"}], "source": "[pic=4]Look, even the glyphs that are broken off of the monolith are glowing.", "context": {"actorId": "9", "conditions": "", "conversantId": "1", "conversation": "act2/capstone/02_ruins_augustus", "conversationId": 343, "entryId": 7, "field": "Dialogue Text", "next": [[343, 8]], "script": ""}, "sourceSha256": "3e5a0ad25828d5962217856c59df1c56a9d733e2b98fe758f110fe71bfdafbd5", "preserveExactly": false, "sourceOrdinal": 4642, "target": "[pic=4]Podívej, září i glyfy odlomené z monolitu.", "targetSha256": "70f9008f1f98732f95a073e98920b33631071f474485895cdba10154c2ca53f5"}
