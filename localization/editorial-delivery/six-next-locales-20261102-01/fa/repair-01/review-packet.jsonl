{"family": "dialogue", "id": "ds:100:99:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/263/dialogueEntries/4/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/263/dialogueEntries/4/fields/6/value"}], "source": "[pic=1]If you aren’t too tired… There is definitely something you can help me out with…", "context": {"actorId": "2", "conditions": "", "conversantId": "1", "conversation": "vslice/bunnyQuest/conclusion", "conversationId": 100, "entryId": 99, "field": "Dialogue Text", "next": [[100, 100]], "script": ""}, "sourceSha256": "732986f59488f3b9c5dd2e52ac2245f5f20b3e0525760e40b1f20935e674bbea", "preserveExactly": false, "target": "[pic=1]اگه زیاد خسته نیستی… قطعاً یه کاری هست که می‌تونی توش کمکم کنی…", "targetSha256": "9af57f1b4ebbb00d7d256c0bed942ccc167eb30b119f6a84590d5539e5526afa"}
{"family": "dialogue", "id": "ds:122:154:Dialogue Text", "selectors": [{"asset": "StreamingAssets/aa/StandaloneWindows64/defaultlocalgroup_assets_all_298c5a4d1d1846b1a8d2c7d5da3f319c.bundle", "kind": "field", "pathId": -9011735310751668748, "pointer": "/conversations/5/dialogueEntries/4/fields/6/value"}, {"asset": "sharedassets0.assets", "kind": "field", "pathId": 3336, "pointer": "/conversations/5/dialogueEntries/4/fields/6/value"}], "source": "Can you swim across the lake\nto the island for me?", "context": {"actorId": "1", "conditions": "", "conversantId": "6", "conversation": "act1/bridgeQuest/05_askOtterForHelp", "conversationId": 122, "entryId": 154, "field": "Dialogue Text", "next": [[122, 155]], "script": ""}, "sourceSha256": "b581e78d5e6165b4331b26021e1a7f2a3389c4e6db768659b5549d0608e6c36e", "preserveExactly": false, "target": "می‌تونی برام از عرض دریاچه شنا کنی\nتا جزیره بری؟", "targetSha256": "aa382e8bd3d15992e6dcf129a0aac169837e0e444dfdc107a617c7e94397fb33"}
