{"id": "author:paired-lines-and-scansion", "document": {"languageSha256": "045c349e39a5eb7a17f39941acbece640c4ad09dd4bc771b95e6cccf40a64593", "pairs": [{"id": "ds:303:325:Dialogue Text", "source": "We molded the Earth", "sourceSha256": "4cfda961aa21c85ecda38ac13d7b241ee2079a92ab6a7606df2e7559dc3abc75", "target": "خاک را شکل دادیم", "targetSha256": "5ad20d6af388a0c5eb383ffada8e1e2a119f21e6f948957df86dc4a7f05b1dac", "evaluationId": "managed:Managed/Assembly-CSharp.dll:System.String TheForestOfLove.Events.TriggerHandlers.TriggerHandlerDates::VNRevivalRuHaiku_Resolve(System.String,System.Int32,System.String)@12", "evaluationTargetSha256": "5ad20d6af388a0c5eb383ffada8e1e2a119f21e6f948957df86dc4a7f05b1dac", "slot": 1, "authorScansion": ["khāk", "rā", "shekl", "dā", "dim"], "syllables": 5, "changed": false, "independentAcceptance": false}, {"id": "ds:303:410:Dialogue Text", "source": "Busy little bug", "sourceSha256": "3c00b34eec68aa4594c7fdce6c254d96aa73c8e7f88226a1cc6053d4dc0c667c", "target": "حشره؛ ریز، چُست", "targetSha256": "678d06c65cf6f8a952e27b3c06fc4851dc479692c237f1819bc85e7a51109c2e", "evaluationId": "managed:Managed/Assembly-CSharp.dll:System.String TheForestOfLove.Events.TriggerHandlers.TriggerHandlerDates::VNRevivalRuHaiku_Resolve(System.String,System.Int32,System.String)@22", "evaluationTargetSha256": "678d06c65cf6f8a952e27b3c06fc4851dc479692c237f1819bc85e7a51109c2e", "slot": 1, "authorScansion": ["ha", "sha", "re", "riz", "čost"], "syllables": 5, "changed": true, "independentAcceptance": false}, {"id": "ds:303:406:Dialogue Text", "source": "Oh lovely Falcon", "sourceSha256": "83c5d22ed4ea07dfec7665439c25eac7dab06620231d5368ee095c3e8a4bbf4d", "target": "شاهینِ زیبا", "targetSha256": "4251f09b9d6f73fca3f4e98d6c7ff5a83943f40342ce5ba14eb195b133730983", "evaluationId": "managed:Managed/Assembly-CSharp.dll:System.String TheForestOfLove.Events.TriggerHandlers.TriggerHandlerDates::VNRevivalRuHaiku_Resolve(System.String,System.Int32,System.String)@32", "evaluationTa