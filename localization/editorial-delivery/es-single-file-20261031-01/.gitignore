# Exact original packets, views and CLI evidence remain locally preserved and
# are committed losslessly in evidence.tar.gz with a verified member index.
/*
!/.gitignore
!/README.md
!/acceptance.json
!/complete-reviews.jsonl
!/source-preserved.jsonl
!/build-manifest.json
!/static-verification.json
!/usage.json
!/serialization-rebind.json
!/evidence-index.json
!/evidence.tar.gz
!/review-reports/
