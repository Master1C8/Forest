{"packet":0,"rowIndex":359,"value":{"context":{"actorId":"14","conditions":"","conversantId":"1","conversation":"dates/oliverCoyotes/dialogue2","conversationId":303,"entryId":365,"field":"Dialogue Text","next":[[303,366]],"script":""},"family":"dialogue","id":"ds:303:365:Dialogue Text","preserveExactly":false,"selectors":[{"asset":{"$r":"D52"},"kind":"field","pathId":-9011735310751668748,"pointer":"/conversations/301/dialogueEntries/44/fields/6/value"},{"asset":"sharedassets0.assets","kind":"field","pathId":3336,"pointer":"/conversations/301/dialogueEntries/44/fields/6/value"}],"source":"[pic=5]It’s interesting to consider though, if \"time\" is the \"river,\" then we are the \"water.\"","sourceSha256":"fc2cc1edf41b00379f17642b9a3775551f01ab0e45b3dbcbeff61561d5a59667"}}
